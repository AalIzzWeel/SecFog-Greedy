{
  "name": "realistic_edge_cloud_app_storage",
  "services": {
    "edge_service": {
      "class": "comparison",
      "profiles": [
        "secure_storage"
      ],
      "requirements": {
        "all": [
          "backup",
          {
            "any": [
              "encrypted_storage",
              "obfuscated_storage"
            ]
          }
        ]
      }
    },
    "cloud_service": {
      "class": "comparison",
      "profiles": [
        "secure_storage",
        "physical_security"
      ],
      "requirements": {
        "all": [
          {
            "all": [
              "backup",
              {
                "any": [
                  "encrypted_storage",
                  "obfuscated_storage"
                ]
              }
            ]
          },
          {
            "any": [
              "anti_tampering",
              "access_control"
            ]
          }
        ]
      }
    }
  }
}